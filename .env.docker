KAFKA_BOOTSTRAP_SERVERS=kafka:29092
KAFKA_TRANSACTIONS_TOPIC=aml.transactions
KAFKA_RESULTS_TOPIC=aml.results
KAFKA_CONSUMER_GROUP=aml-verifier-group
KAFKA_AUTO_OFFSET_RESET=earliest

POSTGRES_HOST=postgres
POSTGRES_PORT=5432
POSTGRES_DB=aml_db
POSTGRES_USER=aml_user
POSTGRES_PASSWORD=aml_password

AMOUNT_THRESHOLD_USD=10000.0
VELOCITY_MAX_TRANSACTIONS=10
VELOCITY_WINDOW_SECONDS=3600

ALERT_WEBHOOK_URL=http://localhost:8888/alerts
ALERT_LOG_ONLY=true

HEALTH_PORT=8080
